<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/zed_ripple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#3C2D0B"
                android:centerColor="#24211A"
                android:endColor="#1D2026" />
            <stroke android:width="1dp" android:color="@color/zed_outline_accent" />
        </shape>
    </item>
</ripple>
