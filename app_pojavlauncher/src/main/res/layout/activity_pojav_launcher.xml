<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ImageView
        android:id="@+id/zed_header_logo"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintBottom_toTopOf="@id/header_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/zed_brand_block"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/header_divider"
        app:layout_constraintStart_toEndOf="@id/zed_header_logo"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:letterSpacing="0.08"
            android:text="@string/zed_toolbar_title"
            android:textColor="@color/zed_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:text="@string/zed_toolbar_subtitle"
            android:textColor="@color/zed_text_secondary"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.kdt.mcgui.mcAccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/zed_account_chip"
        android:dropDownWidth="@dimen/_250sdp"
        android:dropDownVerticalOffset="@dimen/_52sdp"
        android:ellipsize="end"
        android:paddingStart="9dp"
        android:paddingEnd="5dp"
        android:textColor="@color/zed_text_primary"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@id/header_divider"
        app:layout_constraintEnd_toStartOf="@id/setting_button"
        app:layout_constraintStart_toEndOf="@id/zed_brand_block"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/zed_action_button"
        android:contentDescription="@string/mcl_options"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu_settings"
        android:tint="@color/zed_accent"
        app:layout_constraintBottom_toTopOf="@id/header_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="68dp"
        android:background="@color/zed_accent_divider"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintTop_toBottomOf="@id/header_divider" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
