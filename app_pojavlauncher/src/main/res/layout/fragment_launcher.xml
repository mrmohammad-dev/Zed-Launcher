<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:id="@+id/zed_home_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/zed_bottom_panel"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:letterSpacing="0.02"
                        android:text="@string/zed_home_title"
                        android:textColor="@color/zed_accent"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.07"
                        android:text="@string/zed_home_subtitle"
                        android:textColor="@color/zed_text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/zed_status_chip"
                        android:paddingStart="9dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4dp"
                        android:text="@string/zed_home_badge"
                        android:textColor="@color/zed_accent"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/zed_welcome_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.09"
                    android:text="@string/zed_welcome_kicker"
                    android:textColor="@color/zed_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/zed_welcome_title"
                    android:textColor="@color/zed_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/zed_welcome_description"
                    android:textColor="@color/zed_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/zed_tools_title"
                    android:textColor="@color/zed_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/zed_outline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/news_button"
                    style="@style/LauncherMenuButton.Zed"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_menu_news"
                    android:text="@string/zed_source_code" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/custom_control_button"
                    style="@style/LauncherMenuButton.Zed"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_menu_custom_controls"
                    android:text="@string/mcl_option_customcontrol" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/install_jar_button"
                    style="@style/LauncherMenuButton.Zed"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_menu_install_jar"
                    android:text="@string/main_install_jar_file" />

                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/open_files_button"
                    style="@style/LauncherMenuButton.Zed"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_folder"
                    android:text="@string/mcl_button_open_directory" />
            </LinearLayout>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Zed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="9dp"
                android:drawableStart="@android:drawable/ic_menu_share"
                android:text="@string/main_share_logs" />
        </LinearLayout>
    </ScrollView>

    <!-- Keep the legacy view binding, but hide the upstream Discord shortcut until the Zed invite is supplied. -->
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/discord_button"
        style="@style/LauncherMenuButton.Zed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/zed_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/zed_bottom_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/zed_profile_title"
            android:textColor="@color/zed_accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/zed_profile_selector"
                android:drawableEnd="@drawable/spinner_arrow"
                android:textColor="@color/zed_text_primary"
                app:drawableEndPadding="@dimen/_5sdp"
                app:drawableEndSize="@dimen/_16sdp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="@dimen/_30sdp" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/zed_action_button"
                android:contentDescription="@string/zed_profile_title"
                android:padding="13dp"
                android:src="@drawable/ic_edit_profile"
                android:tint="@color/zed_accent" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/zed_play_button_background"
            android:fontFamily="sans"
            android:text="@string/zed_play_button"
            android:textAllCaps="true"
            android:textColor="@color/zed_text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
